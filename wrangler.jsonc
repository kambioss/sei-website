{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sei-website",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sei-website-db",
      "database_id": "f2d01ddc-1be4-4d69-95d7-ad6c05b715c5",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "db06c537610645fb8a5b2137c75299f1"
    }
  ],
  "observability": {
    "enabled": true
  }
}
